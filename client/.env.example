# Master SMP Client Environment Variables

# Backend API Endpoint URL
# For Local Development: http://localhost:5000/api
# For Production Deployment: https://your-backend-domain.com/api
VITE_API_URL=http://localhost:5000/api

# Demo Data Fallback (set to false in production to force live MongoDB backend API calls)
VITE_USE_DEMO=false

# Public Server Branding
VITE_SERVER_NAME=Master SMP
VITE_SERVER_IP=aurax.play.hosting:24295
VITE_DISCORD_URL=https://discord.gg/mastersmp
