NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/master-smp

JWT_SECRET=super_secret_jwt_key_master_smp_2026_change_in_production

# Payment Provider Choice: "mock" | "stripe" | "razorpay" | "paypal"
PAYMENT_PROVIDER=mock

# Stripe Credentials (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay Credentials (India UPI / Cards - https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret...

# PayPal Credentials (https://developer.paypal.com/dashboard/applications)
PAYPAL_CLIENT_ID=your_paypal_client_id
