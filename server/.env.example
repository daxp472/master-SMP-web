# Discord Purchase Logs Webhook URL (Discord Channel -> Edit Channel -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# In-Game Minecraft Server RCON Connection (Auto Rank & Item Fulfillment)
